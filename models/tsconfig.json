/*
The shared API contract, imported by both workspaces. Type only, so nothing is
ever emitted from here — this project exists so tooling (ESLint's projectService,
editors) has a tsconfig.json that owns these files.
*/
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
