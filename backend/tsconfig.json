/*
The editor/lint project: src, the shared models, and prisma.config.ts.
tsconfig.build.json narrows this to what the server actually ships — its
rootDir of ".." covers prisma.config.ts too, but that file is only ever run by
the Prisma CLI, so it stays out of the build to keep it out of dist.
*/
{
  "extends": "../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "../models/**/*.ts",
    "../lib/**/*.ts",
    "prisma.config.ts",
    "prisma/seed.ts"
  ]
}
