// Prisma schema file
// Docs: https://pris.ly/d/prisma-schema
// Configuration (schema path, migrations, .env loading) lives in ../prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  buy
  sell

  @@map("transaction_type")
}

model AppUser {
  id           BigInt                 @id @default(autoincrement())
  name         String                 @unique
  hashPassword String
  cookies      Cookie[]
  transactions PortfolioTransaction[]

  @@map("app-user")
}

model Cookie {
  id        BigInt   @id @default(autoincrement())
  appUserId BigInt   @map("app_user_id")
  value     String   @unique
  createdAt DateTime @map("created_at")
  expiresAt DateTime @map("expires_at")
  appUser   AppUser  @relation(fields: [appUserId], references: [id])

  @@map("cookie")
}

model PortfolioTransaction {
  id              BigInt          @id @default(autoincrement())
  appUserId       BigInt          @map("app_user_id")
  assetId         BigInt          @map("asset_id")
  transactionType TransactionType @map("transaction_type")
  time            DateTime
  shares_amount   Int
  appUser         AppUser         @relation(fields: [appUserId], references: [id])
  asset           Asset           @relation(fields: [assetId], references: [id])

  @@map("portfolio-transaction")
}

model Asset {
  id BigInt @id @default(autoincrement())
  name         String
  ticker       String
  exchange     String
  transactions PortfolioTransaction[]
  history      History[]

  @@map("asset")
}

model History {
  id      BigInt   @id @default(autoincrement())
  time    DateTime @unique
  assetId BigInt   @map("asset_id")
  high    Float
  low     Float
  open    Float
  close   Float
  asset   Asset    @relation(fields: [assetId], references: [id])

  @@map("history")
}
