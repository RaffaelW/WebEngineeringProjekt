// Prisma schema file
// Docs: https://pris.ly/d/prisma-schema
// Configuration (schema path, migrations, .env loading) lives in ../prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  buy
  sell

  @@map("transaction_type")
}

enum TimeFrame {
  min1 @map("1min")
  h1   @map("1h")
  d1   @map("1d")
  w1   @map("1w")
  mo1  @map("1mo")

  @@map("time_frame")
}

model AppUser {
  id           Int                    @id @default(autoincrement())
  name         String                 @unique
  hashPassword String
  transactions PortfolioTransaction[]

  @@map("app-user")
}

model PortfolioTransaction {
  id              Int             @id @default(autoincrement())
  appUserId       Int             @map("app_user_id")
  assetId         Int             @map("asset_id")
  transactionType TransactionType @map("transaction_type")
  time            DateTime
  shares_amount   Int
  appUser         AppUser         @relation(fields: [appUserId], references: [id])
  asset           Asset           @relation(fields: [assetId], references: [id])

  @@map("portfolio-transaction")
}

model Asset {
  id           Int                    @id @default(autoincrement())
  name         String
  ticker       String
  exchange     String
  transactions PortfolioTransaction[]
  history      History[]
  coverage     Coverage[]

  @@map("asset")
}

model History {
  id      Int      @id @default(autoincrement())
  time    DateTime
  assetId Int      @map("asset_id")
  high    Float
  low     Float
  open    Float
  close   Float
  volume  Float
  asset   Asset    @relation(fields: [assetId], references: [id])

  @@unique([assetId, time])
  @@map("history")
}

model Coverage {
  id        Int       @id @default(autoincrement())
  assetId   Int       @map("asset_id")
  timeframe TimeFrame
  start     DateTime
  end       DateTime
  asset     Asset     @relation(fields: [assetId], references: [id])

  @@unique([assetId, timeframe, start, end])
  @@index([assetId, timeframe])
  @@map("coverage")
}
